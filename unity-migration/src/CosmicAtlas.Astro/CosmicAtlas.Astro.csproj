<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pure C# astronomy core. Constraints so it compiles unchanged inside Unity 6 (C# 9, .NET Standard 2.1):
      - no package references, no UnityEngine types (see Runtime/CosmicAtlas.Astro.asmdef: noEngineReferences)
      - no records / init-only setters (need IsExternalInit, absent from netstandard2.1)
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>CosmicAtlas.Astro</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
