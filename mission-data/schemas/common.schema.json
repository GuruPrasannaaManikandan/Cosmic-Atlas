{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions for Cosmic Atlas mission data",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "sourceIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "implStatus": { "enum": ["implemented", "partial", "planned", "unavailable"] },
    "verification": { "enum": ["verified", "conflicting", "unverified"] },
    "fact": {
      "type": "object",
      "required": ["value", "status", "sources"],
      "additionalProperties": false,
      "properties": {
        "value": {},
        "status": { "$ref": "#/$defs/verification" },
        "sources": { "$ref": "#/$defs/sourceIds" },
        "note": { "type": "string" },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "sources"],
            "additionalProperties": false,
            "properties": { "value": {}, "sources": { "$ref": "#/$defs/sourceIds" } }
          }
        }
      }
    },
    "storyText": {
      "type": "object",
      "required": ["text", "sources"],
      "additionalProperties": false,
      "properties": { "text": { "type": "string", "minLength": 1 }, "sources": { "$ref": "#/$defs/sourceIds" } }
    }
  }
}
