# COSMIC ATLAS - docker compose settings. Copy to .env (never commit .env). Every value is optional.

# Host port for the website (the API is reached through it at /api).
WEB_PORT=8080

# Backend log level: debug | info | warning | error
LOG_LEVEL=info

# Extra browser origins allowed to call the API directly (comma separated). Not needed for the same-origin setup;
# only for the Vite dev server or a split frontend/backend deployment. Never use "*".
ATLAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SECRET (optional): enables LLM suggestions for dataset columns the deterministic mapper could not map.
# In production set it with `fly secrets set ANTHROPIC_API_KEY=... -a <api-app>`, never in a file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
