* text=auto
# Files executed or parsed inside Linux containers must keep LF endings, even on Windows checkouts.
*.sh text eol=lf
Dockerfile text eol=lf
*.template text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
requirements*.txt text eol=lf
requirements.lock text eol=lf
*.png binary
*.jpg binary
*.sqlite3 binary
